<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= programme.programmeName %> | EduBridge</title>
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
    <%- include('partials/nav') %>
    <main class="page-shell">
        <header class="page-header programme-detail-header">
            <h1><%= programme.programmeName %></h1>
            <%- include('partials/providerMark', { provider: programme.provider }) %>
            <p>Programme details</p>
            <% if (userRole === 'agent' || userRole === 'student') { %>
                <form method="post" action="/favourites/programmes/<%= programme.programmeId %>">
                    <button class="button-secondary favourite-action <%= isFavourite ? 'is-saved' : '' %>" type="submit" aria-pressed="<%= isFavourite %>"><span class="favourite-icon"><%- include('partials/icon', { icon: 'bookmark' }) %></span><%= isFavourite ? 'Saved' : 'Save' %></button>
                </form>
            <% } %>
        </header>

        <section class="content-card programme-detail-card">
            <dl class="programme-detail-facts">
                <div>
                    <dt>Level</dt>
                    <dd><%= programme.level %></dd>
                </div>
                <div>
                    <dt>Location</dt>
                    <dd><%= programme.location %></dd>
                </div>
                <div>
                    <dt>Duration</dt>
                    <dd><%= programme.duration %></dd>
                </div>
                <div>
                    <dt>Study area</dt>
                    <dd><%= programme.studyArea %></dd>
                </div>
            </dl>
        </section>

        <p><a href="/programmes">Back to programmes</a></p>
    </main>
    <%- include('partials/shellEnd') %>
</body>
</html>
