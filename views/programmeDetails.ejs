<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= programme.programmeName %> | EduBridge</title>
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
    <%- include('partials/nav') %>
    <main class="page-shell">
        <header class="page-header">
            <h1><%= programme.programmeName %></h1>
            <p>Programme details</p>
        </header>

        <section class="content-card">
            <p><strong>Provider:</strong> <%= programme.provider %></p>
            <p><strong>Level:</strong> <%= programme.level %></p>
            <p><strong>Location:</strong> <%= programme.location %></p>
            <p><strong>Duration:</strong> <%= programme.duration %></p>
            <p><strong>Study area:</strong> <%= programme.studyArea %></p>
        </section>

        <p><a href="/programmes">Back to programmes</a></p>
    </main>
</body>
</html>