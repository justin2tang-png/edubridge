<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Programmes | EduBridge</title>
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
    <%- include('partials/nav') %>
    <main class="page-shell">
        <header class="page-header">
            <h1>Programmes</h1>
            <p>Search and explore available study programmes.</p>
        </header>

        <section class="content-card programme-filters" aria-labelledby="programme-filter-title">
            <div class="programme-filter-heading">
                <div>
                    <h2 id="programme-filter-title">Find a programme</h2>
                    <p>Search by programme or provider, then narrow the results if needed.</p>
                </div>
                <span class="programme-result-count"><%= programmes.length %> found</span>
            </div>

            <form action="/programmes" method="get" class="programme-filter-form">
                <div class="programme-search-field">
                    <label for="keyword">Programme or provider</label>
                    <input type="search" id="keyword" name="keyword" value="<%= keyword %>" placeholder="e.g. Business or University of Auckland">
                </div>

                <div class="programme-filter-field">
                    <label for="level">Level</label>
                    <input type="text" id="level" name="level" value="<%= filters.level %>" inputmode="numeric" placeholder="e.g. 7">
                </div>

                <div class="programme-filter-field">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" value="<%= filters.location %>" placeholder="e.g. Auckland">
                </div>

                <div class="programme-filter-field">
                    <label for="studyArea">Study area</label>
                    <input type="text" id="studyArea" name="studyArea" value="<%= filters.studyArea %>" placeholder="e.g. Business">
                </div>

                <div class="programme-filter-actions">
                    <button class="button-primary" type="submit">Apply filters</button>
                    <a class="button-secondary" href="/programmes">Clear all</a>
                </div>
            </form>
        </section>

        <% if (programmes.length === 0) { %>
            <p class="empty-state">No programmes found.</p>
        <% } else { %>
            <div class="programme-grid">
                <% programmes.forEach(function (programme) { %>
                    <article class="content-card programme-card">
                        <h2><%= programme.programmeName %></h2>
                        <%- include('partials/providerMark', { provider: programme.provider }) %>
                        <div class="programme-metadata" aria-label="Programme details">
                            <span><strong>Level</strong><%= programme.level %></span>
                            <span><strong>Location</strong><%= programme.location %></span>
                            <span><strong>Duration</strong><%= programme.duration %></span>
                            <span><strong>Study area</strong><%= programme.studyArea %></span>
                        </div>
                        <div class="card-actions">
                            <a class="button-secondary" href="/programmes/<%= programme.programmeId %>">View programme</a>
                            <% if (userRole === 'agent' || userRole === 'student') { %>
                                <% var programmeIsFavourite = favouriteProgrammeIds.indexOf(programme.programmeId) !== -1; %>
                                <form method="post" action="/favourites/programmes/<%= programme.programmeId %>?from=list">
                                    <button class="button-secondary favourite-action <%= programmeIsFavourite ? 'is-saved' : '' %>" type="submit" aria-pressed="<%= programmeIsFavourite %>"><span class="favourite-icon"><%- include('partials/icon', { icon: 'bookmark' }) %></span><%= programmeIsFavourite ? 'Saved' : 'Save' %></button>
                                </form>
                            <% } %>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } %>

        <p><a href="/">Back to home</a></p>
    </main>
    <%- include('partials/shellEnd') %>
</body>
</html>
