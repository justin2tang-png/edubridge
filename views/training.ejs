<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/public/css/styles.css">
    <title>Training Centre</title>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="page-shell training-centre-page">
        <% var completedModules = trainingModules.filter(function (module) { return module.completedAt; }).length; %>
        <% var totalModules = trainingModules.length; %>
        <% var remainingModules = totalModules - completedModules; %>
        <% var completionPercentage = totalModules === 0 ? 0 : Math.round((completedModules / totalModules) * 100); %>

        <header class="page-header training-centre-header">
            <h1>Training Centre</h1>
            <p>Build your knowledge and professional skills.</p>
        </header>

        <section class="training-summary" aria-label="Learning summary">
            <article class="summary-card">
                <p class="summary-label">Completed Modules</p>
                <p class="summary-number"><%= completedModules %></p>
            </article>
            <article class="summary-card">
                <p class="summary-label">In Progress / Remaining</p>
                <p class="summary-number"><%= remainingModules %></p>
            </article>
            <article class="summary-card">
                <p class="summary-label">Overall Progress</p>
                <p class="summary-number"><%= completionPercentage %>%</p>
            </article>
        </section>

        <section class="training-categories" aria-label="Training categories">
            <nav class="training-tabs" aria-label="Training category filters">
                <a class="training-tab <%= !selectedCategory ? 'is-active' : '' %>" href="/training">All <strong><%= totalModules %></strong></a>
                <% categories.forEach(function (category) { %>
                    <a class="training-tab <%= selectedCategory === category ? 'is-active' : '' %>" href="/training?category=<%= encodeURIComponent(category) %>"><%= category %></a>
                <% }); %>
            </nav>
        </section>

        <% if (totalModules === 0) { %>
            <p class="empty-state">No training modules are available.</p>
        <% } else { %>
            <section class="training-course-grid" aria-label="Training modules">
                <% trainingModules.forEach(function (trainingModule) { %>
                    <% var modulePercentage = trainingModule.completedAt ? 100 : 0; %>
                    <article class="training-course-card">
                        <span class="training-category-label"><%= trainingModule.category || 'Not configured' %></span>
                        <h2><%= trainingModule.title %></h2>
                        <p class="training-course-description"><%= trainingModule.description %></p>
                        <p class="training-course-meta"><%= trainingModule.level || 'Not configured' %> · <%= trainingModule.durationMinutes ? trainingModule.durationMinutes + ' min' : 'Not configured' %></p>
                        <div class="training-progress-label"><span>Progress</span><strong><%= modulePercentage %>%</strong></div>
                        <progress class="training-progress-track" value="<%= modulePercentage %>" max="100"><%= modulePercentage %>%</progress>
                        <div class="training-course-footer">
                            <% if (trainingModule.completedAt) { %>
                                <span class="status-badge status-completed">Completed</span>
                            <% } else { %>
                                <span class="status-badge status-not-completed">Not started</span>
                            <% } %>
                            <a class="button-primary button-compact" href="/training/<%= trainingModule.moduleId %>">View Module</a>
                        </div>
                    </article>
                <% }); %>
            </section>
        <% } %>
    </main>
    <%- include('partials/shellEnd') %>
</body>
</html>
