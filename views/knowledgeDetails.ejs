<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/public/css/styles.css">
    <title><%= article.title %> | Knowledge Base</title>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="page-shell knowledge-detail-page">
        <% function formatDate(value) {
            if (!value) return '';
            var date = new Date(value);
            if (Number.isNaN(date.getTime())) return '';
            return date.toLocaleDateString('en-NZ', { year: 'numeric', month: 'short', day: 'numeric' });
        } %>

        <header class="page-header knowledge-detail-header">
            <p class="case-breadcrumb"><a href="/knowledge">Knowledge Base</a> / <%= article.category %></p>
            <h1><%= article.title %></h1>
            <div class="knowledge-detail-meta">
                <span class="category-badge"><%= article.category %></span>
                <% if (formatDate(article.updatedAt)) { %>
                    <time datetime="<%= new Date(article.updatedAt).toISOString() %>">Updated <%= formatDate(article.updatedAt) %></time>
                <% } %>
            </div>
            <% if (userRole === 'agent') { %>
                <form method="post" action="/favourites/knowledge/<%= article.articleId %>">
                    <button class="button-secondary favourite-action <%= isFavourite ? 'is-saved' : '' %>" type="submit" aria-pressed="<%= isFavourite %>"><span class="favourite-icon"><%- include('partials/icon', { icon: 'bookmark' }) %></span><%= isFavourite ? 'Saved' : 'Save' %></button>
                </form>
            <% } %>
        </header>

        <article class="knowledge-detail-content">
            <p class="eyebrow">Article Content</p>
            <div class="knowledge-article-body"><%= article.content %></div>
            <% if (article.sourceLabel) { %>
                <p class="knowledge-source">Source: <%= article.sourceLabel %></p>
            <% } %>
        </article>

        <% var knowledgeVideoResources = knowledgeResources.filter(function (resource) { return resource.resourceType === 'YouTube'; }); %>
        <% var knowledgeLinkResources = knowledgeResources.filter(function (resource) { return resource.resourceType === 'Official Link'; }); %>
        <% if (knowledgeVideoResources.length > 0) { %>
            <section class="content-resource-section content-resource-section-knowledge">
                <div class="case-panel-heading"><p class="eyebrow">Related Video</p><h2>Related Video</h2></div>
                <div class="resource-video-grid">
                    <% knowledgeVideoResources.forEach(function (resource) { %>
                        <article class="resource-video-card">
                            <div class="resource-video-frame">
                                <iframe src="<%= resource.embedUrl %>" title="<%= resource.title %>" loading="lazy" allowfullscreen></iframe>
                            </div>
                            <div class="resource-video-copy">
                                <h3><%= resource.title %></h3>
                                <% if (resource.sourceLabel) { %><p><%= resource.sourceLabel %></p><% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            </section>
        <% } %>
        <% if (knowledgeLinkResources.length > 0) { %>
            <section class="content-resource-section content-resource-section-knowledge">
                <div class="case-panel-heading"><p class="eyebrow">Official Sources &amp; Further Reading</p><h2>Official Sources &amp; Further Reading</h2></div>
                <div class="resource-link-list">
                    <% knowledgeLinkResources.forEach(function (resource) { %>
                        <a class="resource-link-row" href="<%= resource.externalUrl %>" target="_blank" rel="noopener noreferrer">
                            <span class="resource-link-icon" aria-hidden="true">↗</span>
                            <span class="resource-link-copy"><strong><%= resource.title %></strong><% if (resource.sourceLabel) { %><small><%= resource.sourceLabel %></small><% } %></span>
                            <span class="resource-link-action">Open resource <span aria-hidden="true">↗</span></span>
                        </a>
                    <% }); %>
                </div>
            </section>
        <% } %>

        <p class="knowledge-detail-back"><a class="button-secondary" href="/knowledge">Back to Knowledge Base</a></p>
    </main>
    <%- include('partials/shellEnd') %>
</body>
</html>
