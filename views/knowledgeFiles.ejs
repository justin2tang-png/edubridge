<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/public/css/styles.css">
    <title>File Library | Knowledge Base</title>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="page-shell knowledge-file-page">
        <% function formatDate(value) {
            if (!value) return '';
            var date = new Date(value);
            if (Number.isNaN(date.getTime())) return '';
            return date.toLocaleDateString('en-NZ', { year: 'numeric', month: 'short', day: 'numeric' });
        } %>
        <% function preview(value) {
            var text = (value || '').trim();
            return text.length > 180 ? text.slice(0, 177).trimEnd() + '...' : text;
        } %>

        <header class="page-header knowledge-file-header">
            <p class="case-breadcrumb"><a href="/knowledge">Knowledge Base</a> / File Library</p>
            <h1>File Library</h1>
            <p>Browse provider resources and general reference material. The current library shows the latest available reference for each item.</p>
            <% if (isAdmin) { %>
                <p class="knowledge-admin-actions">
                    <a class="button-primary" href="#upload-knowledge-resource">Upload Resource</a>
                    <% if (showArchived) { %>
                        <a class="button-secondary" href="/knowledge/files">Show Current Only</a>
                    <% } else { %>
                        <a class="button-secondary" href="/knowledge/files?includeArchived=1">Show Archive</a>
                    <% } %>
                </p>
            <% } %>
        </header>

        <% if (isAdmin) { %>
            <details class="knowledge-upload-panel" id="upload-knowledge-resource">
                <summary>Upload Resource</summary>
                <form method="POST" action="/admin/knowledge/files/upload" enctype="multipart/form-data">
                    <label for="resourceGroup">Resource Group</label>
                    <select id="resourceGroup" name="resourceGroup" required>
                        <option value="provider">Provider</option>
                        <option value="general">General</option>
                    </select>

                    <label for="knowledgeProvider">Provider <span>(required for Provider resources)</span></label>
                    <input id="knowledgeProvider" name="provider" type="text" maxlength="150" placeholder="e.g. University of Auckland">

                    <label for="knowledgeResourceType">Resource Type</label>
                    <input id="knowledgeResourceType" name="resourceType" type="text" maxlength="60" required placeholder="e.g. Programme Guide">

                    <label for="knowledgeFileTitle">Title</label>
                    <input id="knowledgeFileTitle" name="title" type="text" maxlength="255" required>

                    <label for="knowledgeFileDescription">Description</label>
                    <textarea id="knowledgeFileDescription" name="description" maxlength="10000"></textarea>

                    <label for="knowledgeVersionLabel">Version</label>
                    <input id="knowledgeVersionLabel" name="versionLabel" type="text" maxlength="80" placeholder="e.g. 2026.1">

                    <label for="knowledgeFileUpload">File</label>
                    <input id="knowledgeFileUpload" name="file" type="file" accept=".pdf,.docx,.pptx,.xlsx,.jpg,.jpeg,.png" required>
                    <p class="form-hint">PDF, DOCX, PPTX, XLSX, JPG, JPEG or PNG. Maximum 25 MB.</p>
                    <button class="button-primary" type="submit">Upload Resource</button>
                </form>
            </details>
        <% } %>

        <form class="knowledge-file-filters" method="GET" action="/knowledge/files">
            <div class="knowledge-file-search">
                <label for="file-query">Search resources</label>
                <input id="file-query" name="q" type="search" value="<%= keyword %>" placeholder="Search files, guides and resources...">
            </div>
            <div>
                <label for="file-country">Country</label>
                <select id="file-country" name="country">
                    <option value="">All countries</option>
                    <% countries.forEach(function (item) { %>
                        <option value="<%= item %>" <%= selectedCountry === item ? 'selected' : '' %>><%= item %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label for="file-provider">Provider</label>
                <select id="file-provider" name="provider">
                    <option value="">All providers</option>
                    <% providers.forEach(function (item) { %>
                        <option value="<%= item %>" <%= selectedProvider === item ? 'selected' : '' %>><%= item %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label for="file-type">File Type</label>
                <select id="file-type" name="fileType">
                    <option value="">All file types</option>
                    <% fileTypes.forEach(function (item) { %>
                        <option value="<%= item %>" <%= selectedFileType === item ? 'selected' : '' %>><%= item %></option>
                    <% }); %>
                </select>
            </div>
            <div class="knowledge-file-filter-actions">
                <a class="button-secondary" href="/knowledge/files">Reset</a>
                <button class="button-primary" type="submit">Search</button>
            </div>
        </form>

        <section class="knowledge-file-list" aria-labelledby="file-library-title">
            <div class="knowledge-section-heading">
                <div>
                    <p class="eyebrow">Resource index</p>
                    <h2 id="file-library-title">Available Resources</h2>
                </div>
                <p class="knowledge-result-count"><%= files.length %> resource<%= files.length === 1 ? '' : 's' %></p>
            </div>

            <% if (files.length === 0) { %>
                <div class="knowledge-empty-state">
                    <h2>No resources found.</h2>
                    <p>Try changing your search or filters.</p>
                </div>
            <% } else { %>
                <% function renderFiles(items) { %>
                <div class="knowledge-file-grid">
                    <% items.forEach(function (file) { %>
                        <article class="knowledge-file-card">
                            <div class="knowledge-resource-meta">
                                <span class="category-badge"><%= file.resourceType || file.fileType %></span>
                                <% if (file.status === 'Archived') { %><span class="status-badge status-archived">Archived</span><% } %>
                                <% if (file.updatedAt && formatDate(file.updatedAt)) { %>
                                    <time datetime="<%= new Date(file.updatedAt).toISOString() %>">Updated <%= formatDate(file.updatedAt) %></time>
                                <% } %>
                            </div>
                            <h3><%= file.title %></h3>
                            <p class="knowledge-file-context">
                                <% if (file.provider) { %><span><strong>Provider:</strong> <%= file.provider %></span><% } %>
                                <% if (file.country) { %><span><strong>Country:</strong> <%= file.country %></span><% } %>
                            </p>
                            <% if (file.versionLabel) { %><p class="knowledge-file-context"><span><strong>Version:</strong> <%= file.versionLabel %></span></p><% } %>
                            <p class="knowledge-file-description"><%= preview(file.description) %></p>
                            <% if (file.sourceSystem || file.sourceUpdatedAt) { %>
                                <p class="knowledge-file-lineage">Current reference<% if (file.sourceSystem) { %> · <%= file.sourceSystem %><% } %></p>
                            <% } %>
                            <a class="knowledge-read-link" href="/knowledge/files/<%= file.fileId %>">View Resource <span aria-hidden="true">&rarr;</span></a>
                        </article>
                    <% }); %>
                </div>
                <% } %>
                <% if (providerResources.length > 0) { %>
                    <section class="knowledge-file-group" aria-labelledby="provider-resources-title">
                        <div class="knowledge-section-heading">
                            <div><p class="eyebrow">Provider-linked</p><h3 id="provider-resources-title">Provider Resources</h3></div>
                            <p class="knowledge-result-count"><%= providerResources.length %> resource<%= providerResources.length === 1 ? '' : 's' %></p>
                        </div>
                        <% renderFiles(providerResources); %>
                    </section>
                <% } %>
                <% if (generalResources.length > 0) { %>
                    <section class="knowledge-file-group" aria-labelledby="general-resources-title">
                        <div class="knowledge-section-heading">
                            <div><p class="eyebrow">Shared reference</p><h3 id="general-resources-title">General Resources</h3></div>
                            <p class="knowledge-result-count"><%= generalResources.length %> resource<%= generalResources.length === 1 ? '' : 's' %></p>
                        </div>
                        <% renderFiles(generalResources); %>
                    </section>
                <% } %>
            <% } %>
        </section>
    </main>
    <%- include('partials/shellEnd') %>
</body>
</html>
