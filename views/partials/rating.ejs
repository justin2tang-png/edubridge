<% var ratingValue = Math.max(1, Math.min(5, Number(rating) || 0)); %>
<span class="rating-display <%= compact ? 'rating-compact' : '' %>" role="img" aria-label="<%= ratingValue %> out of 5">
    <span class="rating-stars" aria-hidden="true"><%= '★'.repeat(ratingValue) + '☆'.repeat(5 - ratingValue) %></span>
    <span class="rating-score"><%= compact ? ratingValue.toFixed(1) : ratingValue + ' out of 5' %></span>
</span>
