<!DOCTYPE html>
<html>
<head>
    <title>Admin overview</title>
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body class="admin-page">
    <%- include('partials/nav') %>

    <main class="admin-shell">
    <header class="page-header">
        <h1>Admin overview</h1>
        <p>EduBridge record summary</p>
    </header>

    <ul class="content-card admin-summary">
        <li>Accounts: <%= userCount %></li>
        <li>Programmes: <%= programmeCount %></li>
        <li>Applications: <%= applicationCount %></li>
        <li>Training modules: <%= trainingModuleCount %></li>
    </ul>

    <% function statValue(value) { return value === null || typeof value === 'undefined' ? '0' : Number(value).toLocaleString('en-NZ', { maximumFractionDigits: 1 }); } %>
    <% function chartMax(rows) { return rows.reduce(function (max, row) { return Math.max(max, Number(row.count) || 0); }, 0); } %>
    <% function chartWidth(value, max) { return max > 0 ? Math.max(4, Math.round(Number(value) / max * 100)) : 0; } %>
    <section class="admin-analytics" aria-labelledby="admin-analytics-title">
        <div class="admin-analytics-heading">
            <div>
                <p class="eyebrow">Platform overview</p>
                <h2 id="admin-analytics-title">Usage Statistics</h2>
            </div>
            <p class="admin-analytics-note">Aggregated from current local records.</p>
        </div>

        <div class="admin-stat-grid">
            <article class="admin-stat-card admin-stat-students"><span>Users</span><strong><%= statValue(statistics.users.total) %></strong><small><%= statValue(statistics.users.students) %> Students · <%= statValue(statistics.users.agents) %> Agents · <%= statValue(statistics.users.admins) %> Admins</small></article>
            <article class="admin-stat-card admin-stat-applications"><span>Applications</span><strong><%= statValue(applicationCount) %></strong><small><%= statistics.applicationStatuses.length %> status groups</small></article>
            <article class="admin-stat-card admin-stat-programmes"><span>Programmes</span><strong><%= statValue(programmeCount) %></strong><small><%= statistics.programmeProviders.length %> providers · <%= statistics.programmeLevels.length %> levels</small></article>
            <article class="admin-stat-card admin-stat-training"><span>Training modules</span><strong><%= statValue(statistics.training.totalModules) %></strong><small><%= statValue(statistics.training.completionCount) %> completion records</small></article>
            <article class="admin-stat-card admin-stat-knowledge"><span>Knowledge</span><strong><%= statValue(statistics.knowledge.articles + statistics.knowledge.faqs) %></strong><small><%= statValue(statistics.knowledge.articles) %> articles · <%= statValue(statistics.knowledge.faqs) %> FAQs · <%= statValue(statistics.knowledge.currentDownloadableResources) %> downloadable</small></article>
            <article class="admin-stat-card admin-stat-engagement"><span>Engagement</span><strong><%= statValue(statistics.engagement.recommendations + statistics.engagement.reviews) %></strong><small><%= statValue(statistics.engagement.recommendations) %> recommendations · <%= statValue(statistics.engagement.reviews) %> reviews · <%= statistics.engagement.averageReviewRating ? statValue(statistics.engagement.averageReviewRating) + '★ average' : 'No ratings' %></small></article>
        </div>

        <div class="admin-chart-grid">
            <article class="admin-chart-card chart-applications">
                <div class="admin-chart-heading"><div><p class="eyebrow">Applications</p><h3>Status distribution</h3></div><span><%= statValue(applicationCount) %> total</span></div>
                <% var applicationMax = chartMax(statistics.applicationStatuses); %>
                <% if (statistics.applicationStatuses.length === 0) { %><p class="admin-chart-empty">No application records yet.</p><% } %>
                <% statistics.applicationStatuses.forEach(function (row) { %>
                    <div class="admin-chart-row"><span><%= row.status %></span><div class="admin-chart-track"><i style="width:<%= chartWidth(row.count, applicationMax) %>%"></i></div><strong><%= row.count %></strong></div>
                <% }); %>
            </article>

            <article class="admin-chart-card chart-programmes">
                <div class="admin-chart-heading"><div><p class="eyebrow">Programmes</p><h3>By provider</h3></div><span><%= statistics.programmeProviders.length %> providers</span></div>
                <% var providerMax = chartMax(statistics.programmeProviders); %>
                <% statistics.programmeProviders.forEach(function (row) { %>
                    <div class="admin-chart-row"><span title="<%= row.provider %>"><%= row.provider %></span><div class="admin-chart-track"><i style="width:<%= chartWidth(row.count, providerMax) %>%"></i></div><strong><%= row.count %></strong></div>
                <% }); %>
            </article>

            <article class="admin-chart-card chart-programmes">
                <div class="admin-chart-heading"><div><p class="eyebrow">Programmes</p><h3>By level</h3></div><span><%= statistics.programmeLevels.length %> levels</span></div>
                <% var levelMax = chartMax(statistics.programmeLevels); %>
                <% statistics.programmeLevels.forEach(function (row) { %>
                    <div class="admin-chart-row"><span><%= row.level %></span><div class="admin-chart-track"><i style="width:<%= chartWidth(row.count, levelMax) %>%"></i></div><strong><%= row.count %></strong></div>
                <% }); %>
            </article>

            <article class="admin-chart-card chart-training">
                <div class="admin-chart-heading"><div><p class="eyebrow">Training</p><h3>Completion coverage</h3></div><span><%= statValue(statistics.training.completionRate) %>%</span></div>
                <div class="admin-chart-row"><span>Modules with completion</span><div class="admin-chart-track"><i style="width:<%= chartWidth(statistics.training.completedModuleCount, statistics.training.totalModules) %>%"></i></div><strong><%= statistics.training.completedModuleCount %>/<%= statistics.training.totalModules %></strong></div>
                <p class="admin-chart-footnote">Average quiz score: <%= statistics.training.averageQuizScore ? statValue(statistics.training.averageQuizScore) + '/' + statValue(statistics.training.averageQuizTotal) + ' (' + statValue(statistics.training.averageQuizPercent) + '%)' : 'No attempts' %>.</p>
            </article>
        </div>
    </section>

<details class="admin-section">
<summary>Accounts</summary>

<table class="data-table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Assigned agent</th>
        <th>Account</th>
    </tr>

    <% users.forEach(function(user) { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td>
                <form method="POST" action="/admin/users/<%= user.id %>/role">
                    <select name="role" required>
                        <option value="student" <%= user.role === 'student' ? 'selected' : '' %>>
                            Student
                        </option>
                        <option value="agent" <%= user.role === 'agent' ? 'selected' : '' %>>
                            Agent
                        </option>
                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>
                            Admin
                        </option>
                    </select>

                    <button type="submit">Save</button>
                </form>
            </td>
            <td>
                <% if (user.role === 'student') { %>
                    <form method="POST" action="/admin/users/<%= user.id %>/agent">
                        <select name="agentId" required>
                            <option value="">Select agent</option>
                            <% users.forEach(function(agent) { %>
                                <% if (agent.role === 'agent') { %>
                                    <option value="<%= agent.id %>" <%= user.agentId === agent.id ? 'selected' : '' %>>
                                        <%= agent.name %>
                                    </option>
                                <% } %>
                            <% }); %>
                        </select>
                        <button type="submit">Save</button>
                    </form>
                <% } else { %>
                    <%= user.agentName || 'Not applicable' %>
                <% } %>
            </td>
            <td>
                <% if (String(user.id) === String(userId)) { %>
                    <span>Current account</span>
                <% } else { %>
                    <form method="POST" action="/admin/accounts/<%= user.id %>/delete">
                        <button class="button-danger" type="submit">Delete</button>
                    </form>
                <% } %>
            </td>
        </tr>
    <% }); %>
</table>
</details>

<details class="admin-section">
<summary>Training modules</summary>

<table class="data-table">
    <tr>
        <th>Module ID</th>
        <th>Title</th>
        <th>Description</th>
    </tr>

    <% trainingModules.forEach(function(module) { %>
        <tr>
            <td><%= module.moduleId %></td>
            <td><%= module.title %></td>
            <td><%= module.description %></td>
        </tr>
    <% }); %>
</table>

<details class="admin-action"><summary>Edit training module</summary>

<form method="POST" action="/admin/training/edit">
    <label for="editModuleId">Module ID</label>
    <input id="editModuleId" name="moduleId" type="number" min="1" required>

    <label for="editModuleTitle">Title</label>
    <input id="editModuleTitle" name="title" type="text" required>

    <label for="editModuleDescription">Description</label>
    <textarea id="editModuleDescription" name="description" required></textarea>

    <button type="submit">Save changes</button>
</form></details>

<details class="admin-action"><summary>Add training module</summary>

<form method="POST" action="/admin/training">
    <label for="title">Title</label>
    <input id="title" name="title" type="text" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" required></textarea>

    <button type="submit">Add module</button>
</form></details>

<details class="admin-action"><summary>Remove training module</summary>

<form method="POST" action="/admin/training/delete">
    <label for="moduleId">Module ID</label>
    <input id="moduleId" name="moduleId" type="number" min="1" required>

    <button class="button-danger" type="submit">Remove module</button>
</form></details>
</details>

<details class="admin-section">
<summary>Knowledge articles</summary>

<table class="data-table">
    <tr>
        <th>Article ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Source</th>
    </tr>

    <% knowledgeArticles.forEach(function(article) { %>
        <tr>
            <td><%= article.articleId %></td>
            <td><%= article.title %></td>
            <td><%= article.category %></td>
            <td><%= article.sourceLabel %></td>
        </tr>
    <% }); %>
</table>

<details class="admin-action"><summary>Add knowledge article</summary>

<form method="POST" action="/admin/knowledge">
    <label for="articleTitle">Title</label>
    <input id="articleTitle" name="title" type="text" required>

    <label for="category">Category</label>
    <input id="category" name="category" type="text" required>

    <label for="content">Content</label>
    <textarea id="content" name="content" required></textarea>

    <label for="sourceLabel">Source</label>
    <input id="sourceLabel" name="sourceLabel" type="text" required>

    <button type="submit">Add article</button>
</form></details>

<details class="admin-action"><summary>Remove knowledge article</summary>

<form method="POST" action="/admin/knowledge/delete">
    <label for="articleId">Article ID</label>
    <input id="articleId" name="articleId" type="number" min="1" required>

    <button class="button-danger" type="submit">Remove article</button>
</form></details>

<details class="admin-action"><summary>Edit knowledge article</summary>

<form method="POST" action="/admin/knowledge/edit">
    <label for="editArticleId">Article ID</label>
    <input id="editArticleId" name="articleId" type="number" min="1" required>

    <label for="editArticleTitle">Title</label>
    <input id="editArticleTitle" name="title" type="text" required>

    <label for="editArticleCategory">Category</label>
    <input id="editArticleCategory" name="category" type="text" required>

    <label for="editArticleContent">Content</label>
    <textarea id="editArticleContent" name="content" required></textarea>

    <label for="editArticleSource">Source</label>
    <input id="editArticleSource" name="sourceLabel" type="text" required>

    <button type="submit">Save changes</button>
</form></details>
</details>

<details class="admin-section">
<summary>Programmes</summary>

<table class="data-table">
    <tr>
        <th>Programme ID</th>
        <th>Name</th>
        <th>Provider</th>
        <th>Actions</th>
    </tr>
    <% programmes.forEach(function(programme) { %>
        <tr>
            <td><%= programme.programmeId %></td>
            <td><%= programme.programmeName %></td>
            <td><%= programme.provider %></td>
            <td><a class="button-secondary button-compact" href="/admin/programmes/<%= programme.programmeId %>/edit">Edit</a></td>
        </tr>
    <% }); %>
</table>

<details class="admin-action"><summary>Edit programme</summary>
<form method="POST" action="/admin/programmes/edit">
    <label for="programmeId">Programme ID</label>
    <input id="programmeId" name="programmeId" type="number" min="1" required>

    <label for="programmeName">Programme name</label>
    <input id="programmeName" name="programmeName" type="text" required>

    <label for="provider">Provider</label>
    <input id="provider" name="provider" type="text" required>

    <label for="programmeLevel">Level</label>
    <input id="programmeLevel" name="level" type="text" required>

    <label for="programmeLocation">Location</label>
    <input id="programmeLocation" name="location" type="text" required>

    <label for="duration">Duration</label>
    <input id="duration" name="duration" type="text" required>

    <label for="programmeStudyArea">Study area</label>
    <input id="programmeStudyArea" name="studyArea" type="text" required>

    <button type="submit">Save programme</button>
</form></details>

<details class="admin-action"><summary>Remove programme</summary>

<form method="POST" action="/admin/programmes/delete">
    <label for="deleteProgrammeId">Programme ID</label>
    <input id="deleteProgrammeId" name="programmeId" type="number" min="1" required>

    <button class="button-danger" type="submit">Remove programme</button>
</form></details>

<details class="admin-action"><summary>Add programme</summary>

<form method="POST" action="/admin/programmes">
    <label for="newProgrammeName">Programme name</label>
    <input id="newProgrammeName" name="programmeName" type="text" required>

    <label for="newProvider">Provider</label>
    <input id="newProvider" name="provider" type="text" required>

    <label for="newLevel">Level</label>
    <input id="newLevel" name="level" type="text" required>

    <label for="newLocation">Location</label>
    <input id="newLocation" name="location" type="text" required>

    <label for="newDuration">Duration</label>
    <input id="newDuration" name="duration" type="text" required>

    <label for="newStudyArea">Study area</label>
    <input id="newStudyArea" name="studyArea" type="text" required>

    <button type="submit">Add programme</button>
</form></details>
</details>

<details class="admin-section">
<summary>Programme recommendations (read-only)</summary>
<table class="data-table">
    <tr><th>Student</th><th>Agent</th><th>Programme</th><th>Status</th><th>Reason</th><th>Student comment</th><th>Created</th></tr>
    <% recommendations.forEach(function(recommendation) { %>
        <tr>
            <td><%= recommendation.studentName %></td>
            <td><%= recommendation.agentName %></td>
            <td><%= recommendation.programmeName %> · <%= recommendation.provider %></td>
            <td><%= recommendation.status %></td>
            <td><%= recommendation.reason %></td>
            <td><%= recommendation.studentComment || '—' %></td>
            <td><%= recommendation.createdAt %></td>
        </tr>
    <% }); %>
</table>
</details>

<details class="admin-section">
<summary>Agent reviews (read-only)</summary>
<table class="data-table">
    <tr><th>Student</th><th>Agent</th><th>Application</th><th>Programme</th><th>Rating</th><th>Comment</th><th>Date</th></tr>
    <% reviews.forEach(function(review) { %>
        <tr>
            <td><%= review.studentName %></td>
            <td><%= review.agentName %></td>
            <td>#<%= review.applicationId %></td>
            <td><%= review.programmeName %></td>
            <td><%- include('partials/rating', { rating: review.rating, compact: true }) %></td>
            <td><%= review.comment %></td>
            <td><%= review.createdAt %></td>
        </tr>
    <% }); %>
</table>
</details>

    </main>
    <%- include('partials/shellEnd') %>

<script>
    document.querySelectorAll('.admin-section').forEach(function (section) {
        section.addEventListener('toggle', function () {
            if (section.open) {
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
</script>

</body>
</html>
